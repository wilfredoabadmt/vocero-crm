# ============================================================
# Panel de Mensajería CRM — Variables de entorno
# Copiar a .env y ajustar. En Coolify, definirlas en Environment.
# ============================================================

# --- Base de datos ---
# Producción (docker-compose la deriva de POSTGRES_PASSWORD):
#   DATABASE_URL=postgres://panel:<password>@db:5432/panel
# Desarrollo local sin Docker (Postgres embebido en ./data/dev-db):
DATABASE_URL=pglite://./data/dev-db
POSTGRES_PASSWORD=cambia-esta-password

# --- Seguridad ---
# 32+ caracteres aleatorios; firma sesiones y cifra secretos en reposo
SESSION_SECRET=dev-session-secret-cambiar-en-produccion-32ch
# Bearer token con el que el tech provider entrega credenciales de bandejas
PROVISIONING_SECRET=dev-provisioning-secret

# --- Meta / WhatsApp (vacíos hasta integrar el número real) ---
# App secret de la app tech provider (verifica firma X-Hub-Signature-256)
META_APP_SECRET=
# Token arbitrario que Meta envía en el handshake GET del webhook
WEBHOOK_VERIFY_TOKEN=

# --- Admin inicial (seed del primer arranque) ---
ADMIN_EMAIL=admin@panel.local
ADMIN_PASSWORD=admin1234

# --- Instancia ---
PUBLIC_URL=http://localhost:3000
# true = endpoints /api/simulate/* activos y envíos a Meta mockeados
SIMULATION_MODE=true
# Carpeta de adjuntos y documentos (volumen en producción)
UPLOADS_DIR=./data/uploads
PORT=3000
