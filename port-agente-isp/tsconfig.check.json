{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/lib/ai/index.ts",
    "src/server/ai/account-context.ts",
    "src/server/ai/actions.ts",
    "src/server/ai/handoff.ts",
    "src/server/ai/prompts.ts",
    "tests/unit/agent-isp.test.ts"
  ]
}
