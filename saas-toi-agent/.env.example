# ============================================================
# Variables de Entorno del Agente de IA — SaaS TOI (ISP)
# ============================================================
# Copia este contenido al archivo .env de tu app.
# Reemplaza los valores entre << >> con los tuyos.
# ============================================================

# ─── Proveedor LLM (OpenRouter) ───────────────────────────
# Tu token de OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_TOKEN=sk-or-v1-TU_TOKEN_AQUI

# URL base del proveedor (OpenRouter, OpenAI-compatible, etc.)
# Si usas OpenAI directamente: https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo a usar (el modelo del agente)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# Modelo del juez (opcional, puede ser más barato)
OPENROUTER_JUDGE_MODEL=anthropic/claude-haiku-4-20250414

# ─── Comportamiento del Agente ────────────────────────────
# Milisegundos de debounce antes de procesar un mensaje
# (para agrupar mensajes rápidos del usuario)
AGENT_COALESCE_MS=6000

# ─── Configuración del Canal WhatsApp ─────────────────────
# Token de acceso de Meta Graph API
META_ACCESS_TOKEN=TU_META_ACCESS_TOKEN

# ID del número de WhatsApp Business (WABA)
META_WABA_ID=TU_WABA_ID

# Token de verificación del webhook
META_WEBHOOK_VERIFY_TOKEN=TU_TOKEN_WEBHOOK

# App Secret de Meta (opcional, para firma HMAC)
META_APP_SECRET=TU_META_APP_SECRET

# ─── App ──────────────────────────────────────────────────
# URL base de tu aplicación (para webhooks, OAuth, etc.)
APP_BASE_URL=https://saas-toi-ssd.89.116.29.168.sslip.io

# ─── Base de Datos ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/saas_toi
